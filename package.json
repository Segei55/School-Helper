{
  "name": "school-helper-desktop",
  "version": "0.1.0",
  "description": "A comprehensive student productivity suite",
  "author": {
    "name": "Sihmer",
    "email": "support@school-helper.app"
  },
  "homepage": "https://school-helper.app",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build:win": "npm run build && electron-builder --win",
    "build:win-portable": "npm run build && electron-builder --win portable",
    "build:linux": "npm run build && cross-env USE_SYSTEM_FPM=true ELECTRON_BUILDER_CACHE=~/.cache/electron-builder electron-builder --linux",
    "build:appimage": "npm run build && electron-builder --linux AppImage",
    "build:snap": "npm run build && electron-builder --linux snap",
    "build:linux-fix": "rm -rf .cache dist_electron && npm run build:linux",
    "build:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.34.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.562.0",
    "motion": "^12.35.0",
    "openai": "^6.29.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.schoolhelper.app",
    "productName": "School Helper",
    "copyright": "Copyright © 2026 Sihmer",
    "directories": {
      "output": "dist_electron",
      "buildResources": "electron"
    },
    "asar": true,
    "protocols": [
      {
        "name": "school-helper-auth",
        "schemes": [
          "school-helper"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        "portable"
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "School Helper",
      "installerIcon": "electron/icon.png",
      "uninstallerIcon": "electron/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "snap",
        "tar.gz"
      ],
      "category": "Education",
      "icon": "icon.png",
      "maintainer": "Sihmer <support@school-helper.app>"
    }
  }
}
